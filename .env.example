# Speech-to-Text API - Environment Configuration

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# API Gateway Port
API_PORT=8000

# Audio Processor Port
AUDIO_PORT=8001

# Transcriber Port
TRANSCRIBER_PORT=8002

# Data Directory (for storing uploaded and processed audio files)
DATA_DIR=./data

# Environment (development/production)
ENVIRONMENT=development

# Logging Level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# Worker Configuration
WORKER_CONCURRENCY=2

# Streaming Workers (for WebSocket connections)
STREAMING_WORKERS=1

# Whisper Model Size (tiny/base/small/medium/large)
# - tiny: Fastest, ~39M parameters (recommended for testing)
# - base: Default, ~74M parameters (good balance)
# - small: ~244M parameters (better accuracy)
# - medium: ~769M parameters (more accurate)
# - large: ~1.5B parameters (best accuracy, slow)
WHISPER_MODEL=base

# Maximum file size in MB (default: 100MB)
MAX_FILE_SIZE=100
